# === PostgreSQL ===
POSTGRES_PASSWORD=your_secure_password_here_change_me

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_USER_ID=your_telegram_id

# === OpenAI ===
OPENAI_API_KEY=your_openai_api_key

# === Google Vision (optional) ===
GOOGLE_VISION_API_KEY=your_google_vision_key

# === Garmin (optional) ===
GARMIN_EMAIL=your_email
GARMIN_PASSWORD=your_password

# === Database URL (для production) ===
DATABASE_URL=postgresql://healthvault:${POSTGRES_PASSWORD}@postgres:5432/healthvault

# === Шифрование пользовательских секретов (#381) ===
# Ключ Fernet для core/infra/secrets.py: им шифруются пароли follower-аккаунтов
# CGM, которые пользователь вводит через /connect_cgm. Без него команда осознанно
# падает, а не пишет пароль в открытом виде.
# Сгенерировать: python -m core.infra.secrets --generate-key
# Держать ТОЛЬКО здесь: если ключ попадёт в тот же архив, что дамп БД, шифрование
# теряет смысл. Ротация — префиксом v2: с чтением обоих (см. модуль).
SECRETS_KEY=generate_me

# === CGM: региональные follower-аккаунты LibreLinkUp (bootstrap) ===
# Приглашение follower'а работает только ВНУТРИ региона, поэтому под каждый
# регион нужен свой аккаунт. Основной путь — /connect_cgm (таблица cgm_followers),
# эта переменная нужна для bootstrap и локальной отладки.
# LLU_FOLLOWERS='[{"region":"RU","email":"follower@example.com","password":"..."}]'
